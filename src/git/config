[init]
	defaultBranch = main

[alias]
	s = status -sb
	l = log --oneline --graph --decorate
	a = add -A
	m = commit -m
	p = "!git pull origin $(git branch --show-current)"
	P = push origin HEAD
	ss = switch
	sc = switch -c
	rcur = reset --hard HEAD
	rpre = reset --soft HEAD^
	root = commit --allow-empty -m "root commit"
	suir = submodule update --init --recursive
