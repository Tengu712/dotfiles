set signcolumn=no

let g:gitgutter_highlight_linenrs = 1

let g:gitgutter_map_keys = 0
let g:gitgutter_close_preview_on_escape = 0
let g:gitgutter_terminal_reports_focus = 0

highlight GitGutterAddLineNr    cterm=NONE ctermfg=Green
highlight GitGutterChangeLineNr cterm=NONE ctermfg=Yellow
highlight GitGutterDeleteLineNr cterm=NONE ctermfg=Red
